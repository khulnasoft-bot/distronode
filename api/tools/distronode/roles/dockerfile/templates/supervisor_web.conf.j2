[supervisord]
nodaemon = True
umask = 022
logfile = /dev/stdout
logfile_maxbytes = 0
pidfile = /var/run/supervisor/supervisor.web.pid

[program:nginx]
{% if kube_dev | bool %}
command = make nginx
directory = /api_devel
{% else %}
command = nginx -g "daemon off;"
{% endif %}
autorestart = true
startsecs = 30
stopasgroup=true
killasgroup=true
stdout_logfile=/dev/stdout
stdout_logfile_maxbytes=0
stderr_logfile=/dev/stderr
stderr_logfile_maxbytes=0

[program:uwsgi]
{% if kube_dev | bool %}
command = make uwsgi
directory = /api_devel
{% else %}
command = /var/lib/api/venv/api/bin/uwsgi /etc/tower/uwsgi.ini
directory = /var/lib/api
{% endif %}
autorestart = true
startsecs = 30
stopasgroup=true
killasgroup=true
stdout_logfile=/dev/stdout
stdout_logfile_maxbytes=0
stderr_logfile=/dev/stderr
stderr_logfile_maxbytes=0

[program:daphne]
{% if kube_dev | bool %}
command = make daphne
directory = /api_devel
{% else %}
command = /var/lib/api/venv/api/bin/daphne -b 127.0.0.1 -p 8051 --websocket_timeout -1 api.asgi:channel_layer
directory = /var/lib/api
{% endif %}
autorestart = true
startsecs = 30
stopasgroup=true
killasgroup=true
stdout_logfile=/dev/stdout
stdout_logfile_maxbytes=0
stderr_logfile=/dev/stderr
stderr_logfile_maxbytes=0

[program:ws-heartbeat]
{% if kube_dev | bool %}
command = make run-ws-heartbeat
directory = /api_devel
{% else %}
command = api-manage run_ws_heartbeat
directory = /var/lib/api
{% endif %}
autorestart = true
startsecs = 30
stopasgroup=true
killasgroup=true
stdout_logfile=/dev/stdout
stdout_logfile_maxbytes=0
stderr_logfile=/dev/stderr
stderr_logfile_maxbytes=0

[program:api-cache-clear]
{% if kube_dev | bool %}
command = make run-cache-clear
directory = /api_devel
{% else %}
command = api-manage run_cache_clear
directory = /var/lib/api
{% endif %}
autorestart = true
startsecs = 30
stopasgroup=true
killasgroup=true
stdout_logfile=/dev/stdout
stdout_logfile_maxbytes=0
stderr_logfile=/dev/stderr
stderr_logfile_maxbytes=0

{% if kube_dev | bool %}
[program:api-autoreload]
command = /api_devel/tools/docker-compose/api-autoreload /api_devel/api
autostart = true
autorestart = true
stopasgroup=true
killasgroup=true
stdout_logfile=/dev/stdout
stdout_logfile_maxbytes=0
stderr_logfile=/dev/stderr
stderr_logfile_maxbytes=0
{% endif %}

[group:tower-processes]
programs=nginx,uwsgi,daphne,api-cache-clear,ws-heartbeat
priority=5

[eventlistener:superwatcher]
command=stop-supervisor
events=PROCESS_STATE_FATAL
stdout_logfile=/dev/stdout
stdout_logfile_maxbytes=0
stderr_logfile=/dev/stderr
stderr_logfile_maxbytes=0

[unix_http_server]
file=/var/run/supervisor/supervisor.web.sock

[supervisorctl]
serverurl=unix:///var/run/supervisor/supervisor.web.sock ; use a unix:// URL  for a unix socket

[rpcinterface:supervisor]
supervisor.rpcinterface_factory = supervisor.rpcinterface:make_main_rpcinterface
