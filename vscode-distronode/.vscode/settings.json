{
  "explorer.fileNesting.enabled": true,
  "editor.codeActionsOnSave": [
    "source.fixAll.eslint"
  ],
  "editor.formatOnSave": true,
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[shellscript]": {
    "editor.tabSize": 4
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[yaml]": {
    // Until https://github.com/distronode/distronode/tree/devel/vscode-distronode/pull/388 is addressed.
    "editor.formatOnSave": false
  },
  "files.exclude": {
    ".task": true,
    ".yarn": true,
    ".vscode-test": true
  },
  "mochaExplorer.cwd": "packages/distronode-language-server",
  "search.exclude": {
    ".vscode-test": true
  },
  "redhat.telemetry.enabled": false,
  "eslint.useESLintClass": true
}