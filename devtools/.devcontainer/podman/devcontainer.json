{
  "name": "distronode-dev-container-podman",
  "image": "ghcr.io/distronode/community-distronode-devtools:latest",
  "containerUser": "root",
  "runArgs": [
    "--cap-add=CAP_MKNOD",
    "--cap-add=NET_ADMIN",
    "--cap-add=SYS_ADMIN",
    "--cap-add=SYS_RESOURCE",
    "--device",
    "/dev/fuse",
    "--security-opt",
    "seccomp=unconfined",
    "--security-opt",
    "label=disable",
    "--security-opt",
    "apparmor=unconfined",
    "--security-opt",
    "unmask=/sys/fs/cgroup",
    "--userns=host",
    "--hostname=distronode-dev-container"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "redhat.distronode"
      ]
    }
  }
}